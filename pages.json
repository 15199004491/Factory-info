{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页"
			}
		},
		{
			"path": "pages/factory/factory",
			"style": {
				"navigationBarTitleText": "加工厂"
			}
		},
		{
			"path": "pages/factory/detail",
			"style": {
				"navigationBarTitleText": "加工厂详情"
			}
		},
		{
			"path": "pages/factory/register",
			"style": {
				"navigationBarTitleText": "加工厂入驻"
			}
		},
		{
			"path": "pages/factory/manage",
			"style": {
				"navigationBarTitleText": "加工厂管理"
			}
		},
		{
			"path": "pages/factory/price",
			"style": {
				"navigationBarTitleText": "发布价格"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#999999",
		"selectedColor": "#3c9cff",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页"
			},
			{
				"pagePath": "pages/factory/factory",
				"text": "加工厂"
			},
			{
				"pagePath": "pages/mine/mine",
				"text": "我的"
			}
		]
	},
	"uniIdRouter": {}
}