			"^tab-bar": "@/components/tab-bar/tab-bar.vue",
			"^uploader-single": "@/components/uploader-single/uploader-single.vue",
			"^sensitive-input": "@/components/sensitive-input/sensitive-input.vue",
			"^sensitive-textarea": "@/components/sensitive-textarea/sensitive-textarea.vue"
		}
	},
