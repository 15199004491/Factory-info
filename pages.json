{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^region-picker": "@/components/region-picker/region-picker.vue",
			"^image-placeholder": "@/components/image-placeholder/image-placeholder.vue",
			"^safe-bottom": "@/components/safe-bottom/safe-bottom.vue",
			"^uploader-single": "@/components/uploader-single/uploader-single.vue",
			"^sensitive-input": "@/components/sensitive-input/sensitive-input.vue",
			"^sensitive-textarea": "@/components/sensitive-textarea/sensitive-textarea.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"enableShareAppMessage": true
			}
		},
		{
			"path": "pages/reserve/list",
			"style": {
				"navigationBarTitleText": "预约信息"
			}
		},
		{
			"path": "pages/mine/register",
			"style": {
				"navigationBarTitleText": "客户房源"
			}
		},
		{
			"path": "pages/mine/mine",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/second/list",
			"style": {
				"navigationBarTitleText": "二手房"
			}
		},
		{
			"path": "pages/second/detail",
			"style": {
				"navigationBarTitleText": "房源详情"
			}
		},
		{
			"path": "pages/second/map",
			"style": {
				"navigationBarTitleText": "位置地图"
			}
		},
		{
			"path": "pages/rent/list",
			"style": {
				"navigationBarTitleText": "租房"
			}
		},
		{
			"path": "pages/rent/detail",
			"style": {
				"navigationBarTitleText": "租房详情"
			}
		},
		{
			"path": "pages/publish/second",
			"style": {
				"navigationBarTitleText": "发布二手房"
			}
		},
		{
			"path": "pages/publish/rent",
			"style": {
				"navigationBarTitleText": "发布租房"
			}
		},
		{
			"path": "pages/mine/qrcode",
			"style": {
				"navigationBarTitleText": "扫码找房"
			}
		},
		{
			"path": "pages/mine/manage",
			"style": {
				"navigationBarTitleText": "房源管理"
			}
		},
		{
			"path": "pages/share/houses",
			"style": {
				"navigationBarTitleText": "房源列表",
				"enableShareAppMessage": true
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}